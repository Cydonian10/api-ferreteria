{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "postgres": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@microsoft/postgres-mcp",
          "run",
          "--no-telemetry",
        ],
        "cwd": ".",
        "environment": {
          "POSTGRES_MCP_DISABLE_CWD_ACCESS": "1",
        },
        "timeout": {
          "startup": 120000,
        },
      },
    },
  },
}
